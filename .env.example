# Copy this file to .env.local and fill in real values.
# Never commit .env.local — only this template is tracked in git.

# --- Supabase (required — lib/db/client.ts throws at import time if unset) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Not read anywhere in the app yet — reserved for a future server-side admin
# client. Safe to leave unset until that's built; never expose it to the client.
SUPABASE_SERVICE_KEY=your-service-role-key

# --- AI (required for /discover and /api/ai/recommendations) ---
# Server-only — never prefix this with NEXT_PUBLIC_, it must not reach the browser.
ANTHROPIC_API_KEY=your-anthropic-key

# --- Admin dashboard (optional) ---
# Comma-separated emails allowed into /admin. Client-exposed by design (just
# an email allowlist for the UI gate) — see lib/auth/adminAllowlist.ts for
# why this alone doesn't protect the underlying data.
NEXT_PUBLIC_ADMIN_EMAILS=

# --- VIALII Travel Engine: flight providers (see ARCHITECTURE.md / PROVIDERS.md) ---
# Provider selection is entirely config-driven — lib/travel-engine/core/config.ts
# reads these, lib/travel-engine/flights/index.ts never hardcodes a provider.
# "mock" is always appended last as a guaranteed fallback and can't be disabled.

# Kiwi.com via RapidAPI — real flight search, already integrated (previously
# the only "real" provider, referred to elsewhere in this codebase as
# RealFlightProvider). Falls back to mock data on any failure (missing key,
# expired plan, network error) — see lib/providers/transport/realFlightProvider.ts.
FLIGHTS_KIWI_ENABLED=true
RAPIDAPI_KEY=

# Duffel — VIALII's first Provider-Adapter-pattern flight source
# (lib/travel-engine/flights/DuffelFlightProvider.ts). Disabled by default;
# both this flag AND a real key are required to activate it. Get a test
# token at https://app.duffel.com after signing up — no live payment
# integration exists in this app yet, so orders are created as Duffel
# "hold" orders (no payment captured), not "instant".
FLIGHTS_DUFFEL_ENABLED=false
DUFFEL_API_KEY=

# Only read by scripts/duffel-live-smoke-test.ts (never by the app itself).
# Leave unset — the smoke test runs search + offer retrieval only without
# it, and never creates a real order. See ARCHITECTURE.md's "Duffel live
# booking flow" section before ever setting this to "true".
LIVE_BOOKING_CONFIRM=

# --- Logging (optional) ---
# debug | info | warn | error. Defaults to "warn" in production, "debug" otherwise.
LOG_LEVEL=
