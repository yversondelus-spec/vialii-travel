# Copy this file to .env.local and fill in real values.
# Never commit .env.local — only this template is tracked in git.

# --- Supabase (required — lib/db/client.ts throws at import time if unset) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Not read anywhere in the app yet — reserved for a future server-side admin
# client. Safe to leave unset until that's built; never expose it to the client.
SUPABASE_SERVICE_KEY=your-service-role-key

# --- AI (required for /discover and /api/ai/recommendations) ---
# Server-only — never prefix this with NEXT_PUBLIC_, it must not reach the browser.
ANTHROPIC_API_KEY=your-anthropic-key

# --- Admin dashboard (optional) ---
# Comma-separated emails allowed into /admin. Client-exposed by design (just
# an email allowlist for the UI gate) — see lib/auth/adminAllowlist.ts for
# why this alone doesn't protect the underlying data.
NEXT_PUBLIC_ADMIN_EMAILS=

# --- Real transport providers (optional, currently inert) ---
# lib/providers/factory.ts always uses mock flight/hotel/activity data right
# now regardless of this flag — the real-provider branch is stubbed out. Set
# these once that integration is built.
USE_REAL_APIS=false
RAPIDAPI_KEY=

# --- Logging (optional) ---
# debug | info | warn | error. Defaults to "warn" in production, "debug" otherwise.
LOG_LEVEL=
